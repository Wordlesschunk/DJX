{
  "mcpServers": {
    "fetch": {
      "disabled": false,
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {},
      "autoApprove": [
        "fetch"
      ]
    },
    "mcp-atlassian": {
      "disabled": false,
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "https://COMPANY.net",
        "JIRA_USERNAME": "dylan.jennings@COMPANY.com",
        "JIRA_API_TOKEN": "COOL_KEY",
        "CONFLUENCE_URL": "https://COMPANY.atlassian.net/wiki",
        "CONFLUENCE_USERNAME": "dylan.jennings@COMPANY.com",
        "CONFLUENCE_API_TOKEN": "COOL_KEY"
      },
      "autoApprove": [
        "confluence_get_page",
        "jira_get_issue",
        "jira_search",
        "jira_search",
        "jira_search",
        "jira_search",
        "jira_search_fields",
        "jira_search_fields",
        "jira_get_field_options",
        "jira_get_field_options",
        "jira_get_field_options"
      ]
    },
    "chrome-devtools": {
      "disabled": true,
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    },
    "jira": {
      "disabled": false,
      "command": "uvx",
      "args": [
        "--native-tls",
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "https://COMPANY.atlassian.net",
        "JIRA_USERNAME": "dylan.jennings@COMPANY.com",
        "JIRA_API_TOKEN": "COOL_KEY"
      },
      "autoApprove": [
        "jira_get_issue",
        "jira_search_fields",
        "jira_search"
      ]
    },
    "mysql": {
      "disabled": true,
      "command": "uvx",
      "args": [
        "--native-tls",
        "--from",
        "mysql-mcp-server",
        "mysql_mcp_server"
      ],
      "env": {
        "MYSQL_HOST": "",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "",
        "MYSQL_PASSWORD": "",
        "MYSQL_DATABASE": ""
      },
      "autoApprove": [
        "get_schema_info",
        "execute_sql"
      ]
    },
    "postman": {
      "disabled": true,
      "command": "npx",
      "args": [
        "-y",
        "@postman/postman-mcp-server"
      ],
      "env": {
        "POSTMAN_API_KEY": "COOL_KEY",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "autoApprove": [
        "getCollection"
      ]
    },
    "bitbucket": {
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@aashari/mcp-server-atlassian-bitbucket"
      ],
      "env": {
        "ATLASSIAN_USER_EMAIL": "dylan.jennings@COMPANY.com",
        "ATLASSIAN_API_TOKEN": "COOL_KEY",
        "BITBUCKET_DEFAULT_WORKSPACE": "COMPANY"
      },
      "autoApprove": [
        "bitbucket_get_pull_request",
        "bitbucket_list_pull_requests",
        "bitbucket_get_repository",
        "bitbucket_list_repositories",
        "bitbucket_get_file",
        "bb_get"
      ]
    },
    "github": {
      "disabled": false,
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer github_pat...."
      }
    }
  }
}
